# ===================================================
# FinFlow - Environment Variables Configuration
# Copy this file to .env or app-specific .env.local
# ===================================================

# Server / Cloud Database Sync Service
PORT=4000
NODE_ENV=development

# Cloud Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/finflow?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/finflow?schema=public

# Authentication & JWT Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Web Client Configuration
NEXT_PUBLIC_APP_NAME="FinFlow"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_ENABLE_OFFLINE_SYNC="true"

# Mobile Client Configuration
MOBILE_API_BASE_URL="http://10.0.2.2:4000/api" # Android emulator localhost
MOBILE_SYNC_INTERVAL_SECONDS=30
