# Logs and runtime caches
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets (CRITICAL: Never commit credentials)
.env
.env*.local
.env.production
*.pem
*.key
*.cert

# Build outputs - Web & Backend
*.tsbuildinfo
web/.next/
web/out/
web/build/
backend/dist/
backend/build/
dist/
.turbo/

# Build outputs - Mobile (Flutter & Dart)
.dart_tool/
.packages
.pub-cache/
.pub/
mobile/.dart_tool/
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# Android build outputs & local secrets
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/app/src/main/assets/
*.keystore
*.jks

# iOS build outputs & CocoaPods
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.framework
mobile/ios/**/*.xcworkspace/xcuserdata/
mobile/ios/**/*.xcodeproj/xcuserdata/

# Local databases & sync cache files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE & OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
