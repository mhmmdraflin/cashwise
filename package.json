{
  "name": "cashwise-project",
  "version": "0.1.0",
  "private": true,
  "description": "CashWise - Aplikasi Pengatur Keuangan Web & Mobile Flutter Hybrid (Offline-First + Cloud Sync)",
  "workspaces": [
    "backend",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:web": "npm --workspace=web run dev",
    "start:web": "npm --workspace=web run start",
    "build:web": "npm --workspace=web run build",
    "build:backend": "npm --workspace=backend run build",
    "build:shared": "npm --workspace=packages/shared run build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "cashwise",
    "finance",
    "offline-first",
    "hybrid-sync",
    "flutter",
    "nextjs",
    "sqlite",
    "postgresql"
  ],
  "author": "CashWise Team",
  "license": "MIT"
}
